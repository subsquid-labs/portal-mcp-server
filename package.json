{
  "name": "sqd-portal-mcp",
  "version": "0.8.5",
  "description": "MCP server wrapping SQD Portal API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist/index.js",
  "bin": {
    "sqd-portal-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/licenses/*.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build:app": "node scripts/generate-app-compat-manifest.mjs && node scripts/build-activity-explorer.mjs",
    "ensure:app": "node scripts/ensure-app-bundle.mjs",
    "preapp:host": "npm run --silent ensure:app",
    "predev": "npm run --silent ensure:app",
    "predev:http": "npm run --silent ensure:app",
    "pretypecheck": "npm run --silent ensure:app",
    "pretest:unit": "npm run --silent ensure:app",
    "pretest:app-contract": "npm run --silent ensure:app",
    "pretest:app-ui": "npm run --silent ensure:app",
    "pretest:catalog-tokens": "npm run --silent ensure:app",
    "build:app-preview": "node scripts/build-activity-explorer-preview.mjs",
    "record:app-fixtures": "tsx scripts/record-app-fixtures.ts",
    "sync:chains": "tsx scripts/sync-chain-metadata.ts",
    "app:host": "tsx scripts/serve-app-host.ts",
    "build": "npm run clean && npm run build:app && tsc -p tsconfig.build.json && npm run copy:third-party-licenses",
    "copy:third-party-licenses": "node scripts/copy-third-party-licenses.mjs",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "test": "tsx scripts/smoke-test.ts",
    "test:protocol": "tsx scripts/test-protocol-modern.ts",
    "test:tools": "tsx scripts/test-tools.ts",
    "test:routing": "tsx scripts/test-routing.ts",
    "test:substrate": "tsx scripts/test-substrate.ts",
    "test:timestamps": "tsx scripts/test-timestamps.ts",
    "test:http-runtime": "tsx scripts/test-http-runtime.ts",
    "test:lockfiles": "node scripts/check-lockfile-sync.mjs",
    "test:workflow-pins": "node scripts/check-workflow-pins.mjs",
    "test:release-reporting": "node --test scripts/test-release-reporting.mjs",
    "test:lean": "node scripts/test-lean-surface.mjs",
    "test:fetch-reliability": "tsx scripts/test-fetch-reliability.ts",
    "test:stdio-backpressure": "tsx scripts/test-stdio-backpressure.ts",
    "test:performance-harness": "tsx scripts/test-performance-harness.ts",
    "test:tool-admission": "tsx scripts/test-tool-admission.ts",
    "test:catalog-tokens": "tsx scripts/measure-catalog-tokens.ts",
    "baseline:catalog-tokens": "tsx scripts/measure-catalog-tokens.ts --write",
    "baseline:quality": "tsx scripts/test-quality.ts --write",
    "eval:model-loop": "tsx scripts/eval-model-loop.ts",
    "test:app-contract": "tsx scripts/test-app-contract.ts",
    "test:app-host": "tsx scripts/test-app-host.ts",
    "test:v084-acceptance-regressions": "tsx scripts/test-v084-acceptance-regressions.ts",
    "test:app-ui": "npm run build:app-preview && tsx scripts/test-app-ui.ts",
    "baseline:app-ui": "SQD_UPDATE_BASELINE=1 npm run test:app-ui",
    "baseline:app-ui:ci": "docker run --rm -v \"$PWD\":/work -v sqd-app-ui-baseline-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.62.1-noble bash -lc \"npm ci --no-audit --no-fund && SQD_UPDATE_BASELINE=1 npm run baseline:app-ui\"",
    "contact-sheet:app-ui": "npm run build:app-preview && tsx scripts/app-ui-contact-sheet.ts",
    "test:data-integrity": "tsx scripts/test-data-integrity.ts",
    "test:live-cooldown": "node scripts/live-test-cooldown.mjs",
    "test:v084-factuality": "tsx scripts/test-v084-factuality.ts",
    "test:bitcoin-fees": "tsx scripts/test-bitcoin-fees.ts",
    "test:scan-order": "tsx scripts/test-scan-order.ts",
    "test:evidence-receipts": "tsx scripts/test-evidence-receipts.ts",
    "test:investigation-prompts": "tsx scripts/test-investigation-prompts.ts",
    "test:investigation-journeys": "tsx scripts/test-investigation-journeys.ts",
    "test:pagination": "tsx scripts/test-pagination.ts",
    "test:client-journeys": "tsx scripts/test-client-journeys.ts",
    "prepare:client-candidate": "node scripts/prepare-client-candidate.mjs",
    "benchmark:v082": "tsx scripts/benchmark-v082.ts",
    "benchmark:paired": "tsx scripts/benchmark-paired-v082.ts",
    "benchmark:compare": "tsx scripts/compare-performance-artifacts.ts",
    "soak:v082": "tsx scripts/soak-v082.ts",
    "test:reliability-live": "tsx scripts/test-reliability-live.ts",
    "test:plugin": "tsx scripts/test-codex-plugin.ts",
    "test:claude-plugin": "tsx scripts/test-claude-plugin.ts",
    "test:grok-plugin": "tsx scripts/test-grok-plugin.ts",
    "test:gemini-extension": "tsx scripts/test-gemini-extension.ts",
    "test:cursor-plugin": "tsx scripts/test-cursor-plugin.ts",
    "test:distribution": "node scripts/check-distribution.mjs",
    "check:directories": "node scripts/check-distribution.mjs --live",
    "package:gemini": "node scripts/package-gemini-extension.mjs",
    "package:mcpb": "node scripts/package-mcpb.mjs",
    "test:mcpb": "tsx scripts/test-mcpb.ts",
    "test:conversations": "tsx scripts/test-conversations.ts",
    "test:realistic-prompts": "tsx scripts/test-realistic-prompts.ts",
    "test:evm-investigator": "tsx scripts/test-evm-investigator.ts",
    "test:negative": "tsx scripts/test-negative.ts",
    "test:quality": "tsx scripts/test-quality.ts",
    "test:package": "tsx scripts/test-package-contents.ts",
    "test:offline": "npm run build && npm run lint && npm run typecheck && npm run test:unit && npm run test:lockfiles && npm run test:workflow-pins && npm run test:release-reporting && npm run test:lean && npm run test:distribution && npm run test:fetch-reliability && npm run test:stdio-backpressure && npm run test:performance-harness && npm run test:tool-admission && npm run test:catalog-tokens && npm run test:app-contract && npm run test:app-ui && npm run test:mcpb && npm run test:evidence-receipts && npm run test:investigation-prompts && npm run test:package",
    "test:live": "npm run test:app-host && npm run test:investigation-journeys && npm run test:pagination && npm test && npm run test:protocol && npm run test:tools && npm run test:live-cooldown && npm run test:v084-factuality && npm run test:bitcoin-fees && npm run test:scan-order && npm run test:v084-acceptance-regressions && npm run test:data-integrity && npm run test:live-cooldown && npm run test:reliability-live && npm run test:evm-investigator && npm run test:routing && npm run test:substrate && npm run test:timestamps && npm run test:http-runtime && npm run test:plugin && npm run test:claude-plugin && npm run test:grok-plugin && npm run test:gemini-extension && npm run test:cursor-plugin && npm run test:client-journeys && npm run test:conversations && npm run test:realistic-prompts && npm run test:negative && npm run test:quality",
    "test:all": "npm run test:offline && npm run test:live",
    "test:ci": "npm run test:all",
    "test:release": "npm run test:ci",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@noble/hashes": "^1.8.0",
    "hono": "^4.13.5",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.200.0 <1",
    "@opentelemetry/sdk-node": ">=0.200.0 <1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.3.14",
    "@cloudflare/workers-types": "^4.20250110.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "gpt-tokenizer": "^4.0.0",
    "lightweight-charts": "^5.2.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "yaml": "^2.9.0"
  }
}
