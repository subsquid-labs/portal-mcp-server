{
  "name": "sqd-portal-mcp",
  "version": "0.7.9",
  "description": "MCP server wrapping SQD Portal API",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sqd-portal-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "tsx scripts/smoke-test.ts",
    "test:tools": "tsx scripts/test-tools.ts",
    "test:routing": "tsx scripts/test-routing.ts",
    "test:substrate": "tsx scripts/test-substrate.ts",
    "test:timestamps": "tsx scripts/test-timestamps.ts",
    "test:http-runtime": "tsx scripts/test-http-runtime.ts",
    "test:plugin": "tsx scripts/test-codex-plugin.ts",
    "test:claude-plugin": "tsx scripts/test-claude-plugin.ts",
    "sync:plugin-skills": "node scripts/sync-plugin-skills.mjs --write",
    "check:plugin-skills": "node scripts/sync-plugin-skills.mjs --check",
    "test:conversations": "tsx scripts/test-conversations.ts",
    "test:realistic-prompts": "tsx scripts/test-realistic-prompts.ts",
    "prompt:taxonomy": "tsx scripts/prompt-taxonomy.ts",
    "test:evm-investigator": "tsx scripts/test-evm-investigator.ts",
    "test:negative": "tsx scripts/test-negative.ts",
    "test:quality": "tsx scripts/test-quality.ts",
    "test:package": "tsx scripts/test-package-contents.ts",
    "test:all": "npm run build && npm test && npm run test:tools && npm run test:evm-investigator && npm run test:routing && npm run test:substrate && npm run test:timestamps && npm run test:http-runtime && npm run test:plugin && npm run test:claude-plugin && npm run test:conversations && npm run test:realistic-prompts && npm run test:negative && npm run test:quality && npm run test:package",
    "test:ci": "npm run test:all",
    "test:release": "npm run test:ci",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "^1.8.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@cloudflare/workers-types": "^4.20250110.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
